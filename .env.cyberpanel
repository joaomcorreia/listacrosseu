# Environment variables for CyberPanel deployment
# Place this in /home/listacross.eu/.env

# Django Settings
DJANGO_SECRET_KEY=your-super-secret-production-key-here
DJANGO_SETTINGS_MODULE=listacrosseu_project.settings_cyberpanel

# Database Configuration (MySQL/MariaDB)
DB_NAME=listacrosseu_prod
DB_USER=listacrosseu_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=3306

# Email Configuration (CyberPanel email)
EMAIL_HOST=mail.listacross.eu
EMAIL_PORT=587
EMAIL_HOST_USER=support@listacross.eu
EMAIL_HOST_PASSWORD=your-email-password

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key